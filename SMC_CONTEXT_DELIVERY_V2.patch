+        run_form(page,mode,'2025-11-02T00:00','2025-11-05T00:00')
+        assert page.evaluate('HKSStudio.job.status')=='COMPLETE',page.inner_text('#message')
+        answer=page.evaluate('HKSStudio.result');r=answer['result']
