-{"backtester/__init__.py": "\"\"\"Offline-only historical replay; importing this package never imports app.py.\"\"\"\n\n__version__ = \"1.0.0\"\n", "backtester/browser_context.py": "\"\"\"Bounded browser-only completed-timeframe context. No strategy code executes here.\n\nThe original financial loop, sizing, fills and account methods are unchanged.\nOnly declared, fully closed UTC aggregates cross to the isolated Python worker.\n\"\"\"\nimport ast\nfrom bisect import bisect_right\nfrom decimal import Decimal, localcontext\n\nfrom .errors import ValidationError\nfrom .models import Candle\n\nCONTRACT = 'HKS_BROWSER_COMPLETED_CONTEXT/1'\nPERIODS = {'15m': 900000, '1h': 3600000}\nMINUTE = 60000\n\n\ndef requirements(definition, warmup_bars):\n    tree = ast.parse(definition['code'])\n    declared = []\n    for node in tree.body:\n        if isinstance(node, (ast.Assign, ast.AnnAssign)):\n            targets = node.targets if isinstance(node, ast.Assign) else [node.target]\n            if any(isinstance(t, ast.Name) and t.id == 'CONTEXT_TIMEFRAMES' for t in targets):\n                declared.append(node.value)\n    if not declared:\n        return {}, warmup_bars\n    if len(declared) != 1:\n        raise ValidationError('Declare CONTEXT_TIMEFRAMES once as a literal dictionary')\n    node = declared[0]\n    if not isinstance(node, ast.Dict) or not 1 <= len(node.keys) <= 2:\n        raise ValidationError('CONTEXT_TIMEFRAMES supports one or two literal 15m/1h requests')\n    result = {}\n    for key, value in zip(node.keys, node.values):\n        if not isinstance(key, ast.Constant) or type(key.value) is not str or key.value not in PERIODS:\n            raise ValidationError('Completed context supports only 15m and 1h from verified 1m input')\n        if key.value in result or not isinstance(value, ast.Constant) or type(value.value) is not int or not 2 <= value.value <= 64:\n            raise ValidationError('Each declared timeframe needs a distinct count from 2 to 64')\n        result[key.value] = value.value\n    # One extra bucket covers an arbitrary minute-aligned start, including a\n    # partially supplied first UTC hour. Evaluation dates are never shortened.\n    needed = max([warmup_bars] + [(count+1)*(PERIODS[tf]//MINUTE) for tf, count in result.items()])\n    return result, needed\n\n\ndef aggregate(rows, timeframe):\n    period = PERIODS[timeframe]\n    required = period//MINUTE\n    result = [];group = [];bucket = None\n    with localcontext() as context:\n        context.prec = 34\n        for bar in rows:\n            start = bar.open_ms//period*period\n            if start != bucket:\n                group = [];bucket = start\n            group.append(bar)\n            if (len(group) == required and group[0].open_ms == start and\n                    bar.end_ms == start+period and\n                    all(b.interval_ms == MINUTE and b.open_ms == start+i*MINUTE for i, b in enumerate(group))):\n                result.append(Candle(bar.symbol, start, period, group[0].open,\n                    max(b.high for b in group), min(b.low for b in group), bar.close,\n                    sum((b.volume for b in group), Decimal(0))))\n    return tuple(result)\n\n\nclass CompletedContext:\n    def __init__(self, dataset, requested, input_warmup_bars, start_ms):\n        if dataset.interval != '1m':\n            raise ValidationError('Completed multi-timeframe context requires verified 1m input')\n        self.requested = requested;self.series = {};self.ends = {}\n        for symbol, rows in dataset.candles.items():\n            if not rows or rows[0].open_ms > start_ms-input_warmup_bars*MINUTE:\n                raise ValidationError(symbol+': missing declared multi-timeframe pre-window warm-up; no delayed or shortened test')\n            for timeframe in requested:\n                bars = aggregate(rows, timeframe);key = symbol, timeframe\n                self.series[key] = bars;self.ends[key] = tuple(b.end_ms for b in bars)\n            self.at(symbol, start_ms)  # Refuse before any simulated entry or fill.\n\n    def at(self, symbol, asof_ms):\n        result = {}\n        for timeframe, count in self.requested.items():\n            key = symbol, timeframe\n            end = bisect_right(self.ends[key], asof_ms)\n            bars = self.series[key][max(0, end-count):end]\n            period = PERIODS[timeframe]\n            if (len(bars) != count or bars[-1].end_ms > asof_ms or\n                    bars[-1].end_ms != asof_ms//period*period or\n                    any(b.open_ms != bars[0].open_ms+i*period for i, b in enumerate(bars))):\n                raise ValidationError(symbol+': insufficient continuous completed '+timeframe+' context at decision time')\n            result[timeframe] = [{'open_ms': b.open_ms, 'interval_ms': b.interval_ms,\n                **{k: str(getattr(b, k)) for k in ('open', 'high', 'low', 'close', 'volume')}} for b in bars]\n        return result\n", "backtester/common.py": "\"\"\"Canonical decimal and UTC contracts. No networking or mutable globals.\"\"\"\nfrom dataclasses import asdict, is_dataclass\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, InvalidOperation\nfrom enum import Enum\nimport hashlib\nimport json\nimport re\n\nfrom .errors import ValidationError\n\nINTERVALS = {\"1m\": 60_000, \"5m\": 300_000, \"15m\": 900_000, \"1h\": 3_600_000}\nSYMBOL = re.compile(r\"[A-Z0-9]{2,24}USDT\\Z\")\nIDENTIFIER = re.compile(r\"[a-zA-Z0-9_-]{1,80}\\Z\")\n\n\ndef decimal(value, name=\"number\", minimum=None, maximum=None):\n    if isinstance(value, bool) or not isinstance(value, (str, int, float, Decimal)):\n        raise ValidationError(f\"{name}: a finite decimal is required\")\n    if len(str(value)) > 80:\n        raise ValidationError(f\"{name}: decimal is too long\")\n    try:\n        result = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        raise ValidationError(f\"{name}: a finite decimal is required\") from None\n    if not result.is_finite() or result.adjusted() > 15 or result.as_tuple().exponent < -18:\n        raise ValidationError(f\"{name}: invalid decimal precision or magnitude\")\n    if minimum is not None and result < Decimal(str(minimum)):\n        raise ValidationError(f\"{name}: must be at least {minimum}\")\n    if maximum is not None and result > Decimal(str(maximum)):\n        raise ValidationError(f\"{name}: must not exceed {maximum}\")\n    return result\n\n\ndef integer(value, name, minimum, maximum):\n    if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= maximum:\n        raise ValidationError(f\"{name}: integer in [{minimum}, {maximum}] required\")\n    return value\n\n\ndef symbol(value):\n    if not isinstance(value, str) or not SYMBOL.fullmatch(value):\n        raise ValidationError(\"symbol: uppercase USDT identity required\")\n    return value\n\n\ndef identifier(value):\n    if not isinstance(value, str) or not IDENTIFIER.fullmatch(value):\n        raise ValidationError(\"invalid identifier\")\n    return value\n\n\ndef timestamp(value):\n    \"\"\"Integer milliseconds or an explicit UTC ISO instant; never infer seconds.\"\"\"\n    if isinstance(value, bool):\n        raise ValidationError(\"UTC timestamp required\")\n    if isinstance(value, int):\n        if 946684800000 <= value < 4102444800000:\n            return value\n        raise ValidationError(\"timestamp must be milliseconds between 2000 and 2100\")\n    if not isinstance(value, str) or len(value) > 32 or not value.endswith((\"Z\", \"+00:00\")):\n        raise ValidationError(\"timestamp must be explicit UTC ISO 8601 or integer milliseconds\")\n    try:\n        dt = datetime.fromisoformat(value.replace(\"Z\", \"+00:00\"))\n        if \"T\" not in value or dt.tzinfo is None or dt.utcoffset().total_seconds() != 0 or dt.microsecond % 1000:\n            raise ValueError\n        delta = dt - datetime(1970, 1, 1, tzinfo=timezone.utc)\n        return timestamp(delta.days * 86_400_000 + delta.seconds * 1000 + delta.microseconds // 1000)\n    except (ValueError, OverflowError):\n        raise ValidationError(\"invalid UTC timestamp\") from None\n\n\ndef utc(value):\n    return datetime.fromtimestamp(value / 1000, timezone.utc).isoformat(timespec=\"milliseconds\").replace(\"+00:00\", \"Z\")\n\n\ndef primitives(value):\n    if is_dataclass(value):\n        return primitives(asdict(value))\n    if isinstance(value, Decimal):\n        return format(value, \"f\")\n    if isinstance(value, Enum):\n        return value.value\n    if isinstance(value, dict):\n        return {str(k): primitives(v) for k, v in value.items()}\n    if isinstance(value, (tuple, list)):\n        return [primitives(v) for v in value]\n    return value\n\n\ndef canonical(value):\n    return json.dumps(primitives(value), sort_keys=True, separators=(\",\", \":\"), ensure_ascii=True, allow_nan=False)\n\n\ndef digest(value):\n    return hashlib.sha256(canonical(value).encode()).hexdigest()\n", "backtester/config.py": "from dataclasses import dataclass\nfrom decimal import Decimal\n\nfrom .common import decimal, digest, integer, timestamp\nfrom .errors import ValidationError\n\n\n@dataclass(frozen=True)\nclass RunConfig:\n    start_ms: int\n    end_ms: int\n    mode: str = \"individual\"\n    initial_capital: Decimal = Decimal(\"1000\")\n    sizing: str = \"risk\"\n    risk_fraction: Decimal = Decimal(\"0.01\")\n    allocation_fraction: Decimal = Decimal(\"0.25\")\n    fixed_notional: Decimal = Decimal(\"100\")\n    max_total_risk_fraction: Decimal = Decimal(\"0.05\")\n    max_positions: int = 3\n    fee_bps: Decimal = Decimal(\"10\")\n    slippage_bps: Decimal = Decimal(\"2\")\n    end_policy: str = \"KEEP_OPEN\"\n    allow_uncertified_futures: bool = False\n\n    def __post_init__(self):\n        for name in (\"start_ms\", \"end_ms\"):\n            object.__setattr__(self, name, timestamp(getattr(self, name)))\n        if self.end_ms <= self.start_ms:\n            raise ValidationError(\"end must be after start; requested intervals are never shortened\")\n        if self.mode not in (\"individual\", \"shared\"):\n            raise ValidationError(\"mode must be individual or shared\")\n        if self.sizing not in (\"risk\", \"fixed_notional\"):\n            raise ValidationError(\"unsupported sizing mode\")\n        if self.end_policy not in (\"KEEP_OPEN\", \"CLOSE_AT_LAST_CLOSE\"):\n            raise ValidationError(\"invalid end policy\")\n        if type(self.allow_uncertified_futures) is not bool:\n            raise ValidationError(\"allow_uncertified_futures must be an explicit boolean\")\n        bounds = {\"initial_capital\": (\"1\", \"1000000000\"), \"risk_fraction\": (\".0001\", \".1\"),\n                  \"allocation_fraction\": (\".0001\", \"1\"), \"fixed_notional\": (\".01\", \"1000000000\"),\n                  \"max_total_risk_fraction\": (\".0001\", \"1\"), \"fee_bps\": (\"0\", \"100\"), \"slippage_bps\": (\"0\", \"100\")}\n        for name, (lo, hi) in bounds.items():\n            object.__setattr__(self, name, decimal(getattr(self, name), name, lo, hi))\n        integer(self.max_positions, \"max_positions\", 1, 20)\n\n    @classmethod\n    def from_dict(cls, raw):\n        if not isinstance(raw, dict) or set(raw) - cls.__dataclass_fields__.keys():\n            raise ValidationError(\"unknown run configuration fields\")\n        if \"start_ms\" not in raw or \"end_ms\" not in raw:\n            raise ValidationError(\"start_ms and end_ms UTC boundaries required\")\n        return cls(**raw)\n\n    @property\n    def content_hash(self):\n        return digest(self)\n", "backtester/data.py": "\"\"\"Bounded local CSV intake. File hashes prove bytes, not exchange authenticity.\"\"\"\nimport csv\nimport hashlib\nimport json\nfrom pathlib import Path\nimport time\n\nfrom .common import INTERVALS, decimal, digest, identifier, symbol, timestamp\nfrom .errors import ResourceLimit, ValidationError\nfrom .models import Candle, Dataset\n\nMAX_ROWS = 200_000\nMAX_FILE_BYTES = 16 * 1024 * 1024\nMAX_TOTAL_BYTES = 32 * 1024 * 1024\nMAX_SYMBOLS = 20\nFIELDS = (\"open_time\", \"open\", \"high\", \"low\", \"close\", \"volume\")\n\n\ndef confined(root, filename):\n    if not isinstance(filename, str) or Path(filename).name != filename or len(filename) > 100:\n        raise ValidationError(\"dataset files must be simple filenames\")\n    root = Path(root).resolve()\n    path = root / filename\n    if path.is_symlink() or not path.is_file() or path.resolve().parent != root:\n        raise ValidationError(\"dataset file is unavailable or unsafe\")\n    return path\n\n\ndef read_candles(path, sym, interval, *, as_of_ms=None, row_limit=MAX_ROWS):\n    try:\n        return _read_candles(path,sym,interval,as_of_ms=as_of_ms,row_limit=row_limit)\n    except (csv.Error, UnicodeError):\n        raise ValidationError(\"invalid CSV encoding or oversized/malformed field\") from None\n\n\ndef _read_candles(path, sym, interval, *, as_of_ms=None, row_limit=MAX_ROWS):\n    sym = symbol(sym)\n    if interval not in INTERVALS:\n        raise ValidationError(\"unsupported candle interval; use 1m, 5m, 15m or 1h\")\n    path = Path(path)\n    if path.stat().st_size > MAX_FILE_BYTES:\n        raise ResourceLimit(\"CSV exceeds the 16 MiB file bound\")\n    interval_ms = INTERVALS[interval]\n    as_of_ms = int(time.time() * 1000) if as_of_ms is None else as_of_ms\n    rows = []\n    with path.open(encoding=\"utf-8-sig\", newline=\"\") as f:\n        reader = csv.DictReader(f, strict=True)\n        if tuple(reader.fieldnames or ()) != FIELDS:\n            raise ValidationError(\"CSV header must be: \" + \",\".join(FIELDS))\n        for line, row in enumerate(reader, 2):\n            if len(rows) >= row_limit:\n                raise ResourceLimit(\"dataset exceeds the 200,000 candle bound\")\n            if None in row or any(v is None for v in row.values()):\n                raise ValidationError(f\"{sym} CSV row {line}: wrong column count\")\n            raw_time = row[\"open_time\"]\n            ts = timestamp(int(raw_time) if raw_time.isascii() and raw_time.isdigit() else raw_time)\n            if ts % interval_ms:\n                raise ValidationError(f\"{sym} row {line}: UTC interval misalignment\")\n            if ts + interval_ms > as_of_ms:\n                raise ValidationError(f\"{sym} row {line}: incomplete/future candle\")\n            if rows and ts != rows[-1].end_ms:\n                kind = \"duplicate/out-of-order\" if ts <= rows[-1].open_ms else \"gap\"\n                raise ValidationError(f\"{sym} row {line}: {kind}; missing candles are never filled\")\n            o, h, lo, c = (decimal(row[k], k, \"0.000000000001\") for k in FIELDS[1:5])\n            v = decimal(row[\"volume\"], \"volume\", 0)\n            if h < max(o, c) or lo > min(o, c) or h < lo:\n                raise ValidationError(f\"{sym} row {line}: inconsistent OHLC\")\n            rows.append(Candle(sym, ts, interval_ms, o, h, lo, c, v))\n    if not rows:\n        raise ValidationError(f\"{sym}: empty dataset\")\n    return tuple(rows)\n\n\ndef load_dataset(root, *, as_of_ms=None):\n    root = Path(root)\n    manifest_path = confined(root, \"manifest.json\")\n    if manifest_path.stat().st_size > 64 * 1024:\n        raise ResourceLimit(\"manifest exceeds 64 KiB\")\n    try:\n        manifest = json.loads(manifest_path.read_text())\n    except (ValueError, UnicodeError):\n        raise ValidationError(\"invalid dataset manifest JSON\") from None\n    if not isinstance(manifest, dict) or type(manifest.get(\"schema_version\")) is not int or manifest.get(\"schema_version\") != 1:\n        raise ValidationError(\"dataset manifest schema_version must be 1\")\n    dataset_id = identifier(manifest.get(\"dataset_id\"))\n    market = manifest.get(\"market\")\n    interval = manifest.get(\"interval\")\n    if market not in (\"SPOT\", \"USDT_LINEAR_PERPETUAL\") or interval not in INTERVALS:\n        raise ValidationError(\"explicit supported market and interval required\")\n    if type(manifest.get(\"synthetic\")) is not bool:\n        raise ValidationError(\"synthetic must be an explicit boolean\")\n    for name in (\"exchange\", \"source\"):\n        if not isinstance(manifest.get(name), str) or not 1 <= len(manifest[name]) <= 1000:\n            raise ValidationError(f\"dataset {name} required\")\n    if manifest.get(\"retrieved_at\") is not None:\n        timestamp(manifest[\"retrieved_at\"])\n    files = manifest.get(\"files\")\n    if not isinstance(files, list) or not 1 <= len(files) <= MAX_SYMBOLS:\n        raise ValidationError(\"manifest must contain 1\u201320 symbol CSVs\")\n    candles, hashes, count, size = {}, {}, 0, 0\n    for item in files:\n        if not isinstance(item, dict):\n            raise ValidationError(\"invalid manifest file entry\")\n        sym = symbol(item.get(\"symbol\"))\n        if sym in candles:\n            raise ValidationError(\"duplicate manifest symbol\")\n        path = confined(root, item.get(\"file\"))\n        size += path.stat().st_size\n        if size > MAX_TOTAL_BYTES:\n            raise ResourceLimit(\"dataset exceeds 32 MiB\")\n        sha = hashlib.sha256(path.read_bytes()).hexdigest()\n        if sha != item.get(\"sha256\"):\n            raise ValidationError(f\"{sym}: input SHA-256 mismatch\")\n        values = read_candles(path, sym, interval, as_of_ms=as_of_ms, row_limit=MAX_ROWS - count)\n        count += len(values)\n        candles[sym], hashes[item[\"file\"]] = values, sha\n    hashes[\"manifest.json\"] = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n    warnings = [\"CSV source identity is declared by the supplier; local SHA-256 is not independent exchange provenance.\",\n                \"Historical tick/lot/notional filters and order-book liquidity are not supplied or certified.\"]\n    if manifest.get(\"retrieved_at\") is None:\n        warnings.append(\"Original network retrieval timestamp is unknown; no receipt timestamp was reconstructed.\")\n    if market == \"USDT_LINEAR_PERPETUAL\":\n        warnings.append(\"DIAGNOSTIC linear-Futures price replay at 1x collateral only: funding, mark-price liquidation, maintenance margin and historical leverage tiers are NOT modeled.\")\n    return Dataset(dataset_id, manifest[\"exchange\"], market, interval, manifest[\"synthetic\"],\n                   manifest[\"source\"], manifest.get(\"retrieved_at\"), candles, hashes,\n                   digest({\"hashes\": hashes, \"market\": market, \"interval\": interval}), tuple(warnings))\n\n\ndef coverage(dataset):\n    return [{\"symbol\": s, \"candles\": len(rows), \"first_open_ms\": rows[0].open_ms,\n             \"last_complete_ms\": rows[-1].end_ms, \"missing_intervals\": 0,\n             \"duplicate_timestamps\": 0, \"interval\": dataset.interval}\n            for s, rows in sorted(dataset.candles.items())]\n", "backtester/errors.py": "class ValidationError(ValueError):\n    \"\"\"Safe, actionable input validation failure.\"\"\"\n\n\nclass ResourceLimit(ValidationError):\n    \"\"\"A documented local processing bound was reached; no partial success.\"\"\"\n", "backtester/models.py": "from dataclasses import dataclass, field\nfrom decimal import Decimal\nfrom typing import Protocol, Sequence\n\n\n@dataclass(frozen=True)\nclass Candle:\n    symbol: str\n    open_ms: int\n    interval_ms: int\n    open: Decimal\n    high: Decimal\n    low: Decimal\n    close: Decimal\n    volume: Decimal\n\n    @property\n    def end_ms(self):\n        \"\"\"Exclusive completion boundary, not a fabricated tick timestamp.\"\"\"\n        return self.open_ms + self.interval_ms\n\n\n@dataclass(frozen=True)\nclass Signal:\n    symbol: str\n    timestamp_ms: int\n    side: str  # LONG, SHORT, or NO_SIGNAL\n    reason: str\n    stop_fraction: Decimal\n    target_fraction: Decimal | None = None\n\n\nclass SignalStrategy(Protocol):\n    warmup_bars: int\n    version_id: str\n    content_hash: str\n\n    def evaluate(self, history: Sequence[Candle]) -> Signal: ...\n\n\n@dataclass(frozen=True)\nclass Dataset:\n    dataset_id: str\n    exchange: str\n    market: str\n    interval: str\n    synthetic: bool\n    source: str\n    retrieved_at: str | None\n    candles: dict[str, tuple[Candle, ...]]\n    input_hashes: dict[str, str]\n    content_hash: str\n    warnings: tuple[str, ...] = ()\n\n\n@dataclass\nclass Position:\n    trade_id: str\n    account: str\n    symbol: str\n    side: str\n    signal_ms: int\n    entry_ms: int\n    entry_raw: Decimal\n    entry_price: Decimal\n    quantity: Decimal\n    notional: Decimal\n    margin: Decimal\n    risk_budget: Decimal\n    planned_risk: Decimal\n    initial_stop: Decimal\n    stop: Decimal\n    target: Decimal | None\n    entry_fee: Decimal\n    strategy_version: str\n    entry_reason: str\n    mfe: Decimal = Decimal(0)\n    mae: Decimal = Decimal(0)\n    entry_slippage: Decimal = Decimal(0)\n    state: str = \"OPEN\"\n", "backtester/portfolio.py": "\"\"\"Fully collateralized spot / diagnostic 1x linear-PnL accounting.\"\"\"\nfrom dataclasses import asdict, dataclass, field\nfrom decimal import Decimal\n\nfrom .common import digest\nfrom .models import Position\n\nZERO = Decimal(0)\nONE = Decimal(1)\nTENK = Decimal(10000)\n\n\n@dataclass\nclass Account:\n    name: str\n    initial: Decimal\n    market: str\n    cash: Decimal\n    positions: dict = field(default_factory=dict)\n    closed: list = field(default_factory=list)\n    marks: dict = field(default_factory=dict)\n    peak_equity: Decimal = ZERO\n    max_drawdown: Decimal = ZERO\n    max_drawdown_fraction: Decimal = ZERO\n\n    def equity(self):\n        if self.market == \"SPOT\":\n            return self.cash + sum((p.quantity * self.marks[p.symbol] for p in self.positions.values()), ZERO)\n        return self.cash + sum((p.margin + self.unrealized(p) for p in self.positions.values()), ZERO)\n\n    def unrealized(self, p):\n        return (self.marks[p.symbol] - p.entry_price) * p.quantity * (1 if p.side == \"LONG\" else -1)\n\n    def reserved(self):\n        return sum((p.margin for p in self.positions.values()), ZERO)\n\n    def reserved_risk(self):\n        return sum((p.planned_risk for p in self.positions.values()), ZERO)\n\n    def observe_equity(self, ts):\n        eq = self.equity()\n        self.peak_equity = max(self.peak_equity, eq)\n        dd = self.peak_equity - eq\n        self.max_drawdown = max(self.max_drawdown, dd)\n        if self.peak_equity > 0:\n            self.max_drawdown_fraction = max(self.max_drawdown_fraction, dd / self.peak_equity)\n        return {\"timestamp_ms\": ts, \"account\": self.name, \"cash\": self.cash,\n                \"reserved_capital\": self.reserved(), \"reserved_risk\": self.reserved_risk(),\n                \"unrealized_pnl\": sum((self.unrealized(p) for p in self.positions.values()), ZERO),\n                \"equity\": eq, \"drawdown\": dd}\n\n    def enter(self, signal, bar, config, strategy_version):\n        if signal.symbol in self.positions:\n            return None, \"POSITION_ALREADY_OPEN\"\n        if len(self.positions) >= config.max_positions:\n            return None, \"MAX_CONCURRENT_POSITIONS\"\n        if self.market == \"SPOT\" and signal.side == \"SHORT\":\n            return None, \"SPOT_SHORT_UNSUPPORTED\"\n        eq = self.equity()\n        if eq <= 0:\n            return None, \"NONPOSITIVE_EQUITY\"\n        sign = 1 if signal.side == \"LONG\" else -1\n        price = bar.open * (ONE + sign * config.slippage_bps / TENK)\n        budget = eq * config.risk_fraction\n        distance = price * signal.stop_fraction\n        stop_rule=getattr(signal,'stop_rule',None)\n        target_rule=getattr(signal,'target_rule',None)\n        if stop_rule:\n            kind,value=stop_rule\n            distance=price*value if kind=='fraction' else (value if kind=='distance' else sign*(price-value))\n            if not price*Decimal('.0001')<=distance<=price*Decimal('.5'):\n                return None,'PYTHON_STOP_INVALID_AT_ACTUAL_FILL'\n        desired = budget / distance if config.sizing == \"risk\" else config.fixed_notional / price\n        # Fixed precision is a simulator lot convention, NOT an exchange filter.\n        quantity = min(desired, eq * config.allocation_fraction / price)\n        quantity = (quantity // Decimal(\"0.00000001\")) * Decimal(\"0.00000001\")\n        if quantity <= 0:\n            return None, \"SIZE_ROUNDS_TO_ZERO\"\n        notional = quantity * price\n        fee = notional * config.fee_bps / TENK\n        planned = distance * quantity\n        if planned > budget + Decimal(\"1e-25\"):\n            return None, \"PER_TRADE_RISK_LIMIT\"\n        if self.reserved_risk() + planned > eq * config.max_total_risk_fraction:\n            return None, \"AGGREGATE_RISK_LIMIT\"\n        if notional + fee > self.cash:\n            return None, \"INSUFFICIENT_AVAILABLE_FUNDS\"\n        stop = price - sign * distance\n        target = None if signal.target_fraction is None else price * (ONE + sign * signal.target_fraction)\n        if target_rule:\n            kind,value=target_rule\n            target=price*(ONE+sign*value) if kind=='fraction' else (price+sign*value if kind=='distance' else value)\n            if target<=0 or sign*(target-price)<=0:return None,'PYTHON_TARGET_INVALID_AT_ACTUAL_FILL'\n        trade_id = digest([self.name, signal.symbol, signal.timestamp_ms, signal.side, strategy_version])\n        p = Position(trade_id, self.name, signal.symbol, signal.side, signal.timestamp_ms,\n                     bar.open_ms, bar.open, price, quantity, notional, notional, budget, planned,\n                     stop, stop, target, fee, strategy_version, signal.reason,\n                     entry_slippage=abs(price - bar.open) * quantity)\n        self.cash -= notional + fee\n        self.positions[p.symbol] = p\n        return p, \"ACCEPTED\"\n\n    def close(self, p, raw_price, ts, config, reason, fill_window, ambiguity=False):\n        sign = 1 if p.side == \"LONG\" else -1\n        price = raw_price * (ONE - sign * config.slippage_bps / TENK)\n        gross = sign * (price - p.entry_price) * p.quantity\n        exit_fee = price * p.quantity * config.fee_bps / TENK\n        self.cash += (price * p.quantity if self.market == \"SPOT\" else p.margin + gross) - exit_fee\n        row = asdict(p)\n        row.update({\"state\": \"CLOSED\", \"exit_ms\": ts, \"exit_raw\": raw_price, \"exit_price\": price,\n                    \"exit_reason\": reason, \"gross_pnl\": gross, \"entry_fee\": p.entry_fee,\n                    \"exit_fee\": exit_fee, \"fees\": p.entry_fee + exit_fee,\n                    \"net_pnl\": gross - p.entry_fee - exit_fee,\n                    \"slippage_cost\": p.entry_slippage + abs(raw_price - price) * p.quantity,\n                    \"gross_before_slippage\": sign * (raw_price - p.entry_raw) * p.quantity,\n                    \"mfe_pct\": p.mfe / p.entry_price * 100,\n                    \"mae_pct\": p.mae / p.entry_price * 100,\n                    \"holding_ms\": ts - p.entry_ms,\n                    \"fill_window_start_ms\": fill_window[0], \"fill_window_end_ms\": fill_window[1],\n                    \"timestamp_precision\": (\"CANDLE_CLOSE_PROXY\" if reason == \"END_OF_TEST_EXPLICIT\" else\n                                            (\"MODEL_BAR_OPEN\" if fill_window[0] == fill_window[1] else \"CANDLE_INTERVAL_ONLY\")),\n                    \"excursion_precision\": \"CONSERVATIVE_BOUND_ON_EXIT_CANDLE\",\n                    \"ambiguous_stop_target\": ambiguity,\n                    \"funding\": None if self.market != \"SPOT\" else ZERO})\n        if hasattr(self,'finalize_trade'):row=self.finalize_trade(p,row)\n        self.closed.append(row)\n        del self.positions[p.symbol]\n        return row\n\n    def reconcile(self):\n        \"\"\"Independent reconstruction from immutable entries/closed records.\"\"\"\n        closed_net = self.closed.net_total if hasattr(self.closed,'net_total') else sum((t[\"net_pnl\"] for t in self.closed), ZERO)\n        open_fees = sum((p.entry_fee for p in self.positions.values()), ZERO)\n        expected_cash = self.initial + closed_net - self.reserved() - open_fees\n        expected_equity = self.initial + closed_net - open_fees + sum((self.unrealized(p) for p in self.positions.values()), ZERO)\n        return {\"expected_cash\": expected_cash, \"actual_cash\": self.cash,\n                \"cash_residual\": self.cash - expected_cash,\n                \"expected_equity\": expected_equity, \"actual_equity\": self.equity(),\n                \"equity_residual\": self.equity() - expected_equity}\n", "backtester/python_definition.py": "\"\"\"Parse metadata/syntax only. User Python is NEVER evaluated in this module.\"\"\"\nimport ast\nfrom dataclasses import dataclass\nfrom decimal import Decimal\n\nfrom .common import digest\nfrom .errors import ValidationError\nfrom .models import Signal\n\n\ndef validate(raw):\n    if not isinstance(raw,dict) or set(raw)!={'schema_version','kind','name','code'} or raw.get('kind')!='PYTHON_STRATEGY' or type(raw.get('schema_version')) is not int or raw['schema_version']!=1:\n        raise ValidationError('expected PYTHON_STRATEGY/1 with name and code')\n    name,code=raw['name'],raw['code']\n    if not isinstance(name,str) or not 1<=len(name)<=80 or any(ord(c)<32 for c in name):raise ValidationError('strategy name requires 1\u201380 printable characters')\n    if not isinstance(code,str) or not code.strip() or len(code.encode())>12000:raise ValidationError('Python source requires 1\u201312000 UTF-8 bytes')\n    try:tree=ast.parse(code,filename='strategy.py')\n    except (SyntaxError,ValueError) as e:raise ValidationError('Python syntax error at line '+str(getattr(e,'lineno','?'))+': '+str(getattr(e,'msg','invalid source'))) from None\n    if not any(isinstance(n,ast.FunctionDef) and n.name=='on_bar' and len(n.args.args)==1 and not n.args.vararg and not n.args.kwarg for n in tree.body):\n        raise ValidationError('define on_bar(ctx) with one argument; Python executes only in the isolated runner')\n    warmup=100\n    for n in tree.body:\n        if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='WARMUP_BARS' for t in n.targets):\n            if not isinstance(n.value,ast.Constant) or type(n.value.value) is not int or not 2<=n.value.value<=501:raise ValidationError('WARMUP_BARS must be a literal integer from 2 to 501')\n            warmup=n.value.value\n    return {'schema_version':1,'kind':'PYTHON_STRATEGY','name':name,'code':code},warmup\n\n\n@dataclass(frozen=True)\nclass PythonSpec:\n    definition:dict\n    content_hash:str\n    warmup_bars:int\n    @property\n    def version_id(self):return 'PYTHON_V1_'+self.content_hash\n    def evaluate(self,history):raise ValidationError('Python requires the verified isolated container runner; no host execution fallback')\n\n\n@dataclass(frozen=True)\nclass PythonSignal(Signal):\n    stop_rule:tuple|None=None\n    target_rule:tuple|None=None\n\n\ndef build(raw):\n    definition,warmup=validate(raw)\n    return PythonSpec(definition,digest(definition),warmup)\n\n\nTEMPLATE='''from decimal import Decimal as D\n\nWARMUP_BARS = 51\n\ndef on_bar(ctx):\n    # All history is completed candles. No future candles are supplied.\n    fast = ctx.sma(10)\n    slow = ctx.sma(50)\n    atr = ctx.atr(14)\n    p = ctx.position\n    if p is None:\n        if atr <= 0:\n            return None\n        if fast > slow and ctx.close > ctx.history[-2].close:\n            return ctx.enter(\"LONG\", stop_distance=2 * atr, target_distance=4 * atr)\n        # SHORT is supported only in diagnostic Futures, never ordinary Spot.\n        return None\n    if p.side == \"LONG\" and fast < slow:\n        return ctx.exit()\n    # Custom Python indicators and state are allowed inside the OS sandbox.\n    if p.quantity == p.original_quantity and p.unrealized_fraction >= D(\"0.03\"):\n        return ctx.manage(reduce_fraction=D(\"0.25\"), stop=max(p.stop, p.entry_price))\n    if p.side == \"LONG\":\n        return ctx.manage(stop=max(p.stop, ctx.close - 2 * atr))\n    return ctx.manage(stop=min(p.stop, ctx.close + 2 * atr))\n'''\n", "backtester/python_runtime.py": "\"\"\"Trusted decision validator; user code runs across inherited container pipes.\"\"\"\nfrom dataclasses import asdict\nfrom decimal import Decimal\nimport os\n\nfrom .common import decimal,primitives\nfrom .errors import ValidationError\nfrom .python_definition import build,PythonSignal\nfrom .python_sandbox import RPC\n\n\nclass PythonRuntime:\n    managed=True\n    python_runtime=True\n    def __init__(self,definition):\n        spec=build(definition)\n        self.definition=spec.definition;self.content_hash=spec.content_hash;self.version_id=spec.version_id;self.warmup_bars=spec.warmup_bars\n        try:read=int(os.environ['HKS_SANDBOX_READ_FD']);write=int(os.environ['HKS_SANDBOX_WRITE_FD'])\n        except (KeyError,ValueError):raise ValidationError('isolated Python channel missing; ordinary subprocess execution is forbidden') from None\n        self.rpc=RPC(read,write);self.previous={};self.signals={}\n\n    def after_close(self,account,bar,history):\n        if len(history)<self.warmup_bars:return\n        previous=self.previous.get(bar.symbol)\n        if previous is not None and bar.open_ms!=previous+bar.interval_ms:raise ValidationError('Python observation chronology mismatch')\n        rows=history if previous is None else (bar,)\n        position=account.positions.get(bar.symbol)\n        p=None\n        if position:\n            p={k:getattr(position,k) for k in ['trade_id','side','entry_ms','entry_price','quantity','stop','initial_stop','target','planned_risk','mfe','mae']}\n            p['original_quantity']=getattr(position,'original_quantity',position.quantity)\n            p['unrealized_fraction']=(bar.close-position.entry_price)/position.entry_price*(1 if position.side=='LONG' else -1)\n        decision=self.rpc.call({'symbol':bar.symbol,'bars':primitives([asdict(b) for b in rows]),'position':primitives(p),\n                                'account':primitives({'equity':account.equity(),'cash':account.cash,'reserved_capital':account.reserved(),'reserved_risk':account.reserved_risk()})})\n        self.previous[bar.symbol]=bar.open_ms\n        self.signals[bar.symbol]=self.validate(decision,position,bar)\n\n    def validate(self,decision,p,bar):\n        decision={} if decision is None else decision\n        if not isinstance(decision,dict) or set(decision)-{'enter','close','reduce_fraction','stop','target'}:raise ValidationError('on_bar must return None or supported entry/close/reduction/stop/target actions')\n        side='NO_SIGNAL';stop=None;target=None\n        entry=decision.get('enter')\n        if entry is not None:\n            if not isinstance(entry,dict) or set(entry)!={'side','stop','target'} or entry['side'] not in {'LONG','SHORT'}:raise ValidationError('use ctx.enter(LONG/SHORT, stop_..., target_...)')\n            side=entry['side']\n            def rule(value,required):\n                if value is None and not required:return None\n                if not isinstance(value,dict) or set(value)!={'mode','value'} or value['mode'] not in {'fraction','distance','price'}:raise ValidationError('stop/target requires fraction, distance or price')\n                v=decimal(value['value'],'Python stop/target','.000000000000000001','1000000000000000')\n                if value['mode']=='fraction' and v>Decimal('2'):raise ValidationError('fraction exceeds supported 2x price distance')\n                return value['mode'],v\n            stop=rule(entry['stop'],True);target=rule(entry['target'],False)\n        manage=set(decision)-{'enter'}\n        if manage:\n            if p is None:raise ValidationError('position-management action requires an actual open position')\n            if 'close' in decision and decision['close'] is not True:raise ValidationError('close action must be true')\n            if 'close' in decision and 'reduce_fraction' in decision:raise ValidationError('choose close or reduce_fraction, not both')\n            candidate=None;partials=[];close='PYTHON_EXIT_NEXT_OPEN' if decision.get('close') else None\n            if 'stop' in decision:\n                candidate=decimal(decision['stop'],'updated stop','.000000000000000001','1000000000000000')\n                if (p.side=='LONG' and candidate<p.stop) or (p.side=='SHORT' and candidate>p.stop):raise ValidationError('stop loosening is forbidden; use max/min of the active stop and your candidate')\n            if 'reduce_fraction' in decision:\n                fraction=decimal(decision['reduce_fraction'],'position reduction','.00000001','1')\n                if fraction==1:close='PYTHON_EXIT_NEXT_OPEN'\n                else:\n                    quantity=(p.quantity*fraction//Decimal('.00000001'))*Decimal('.00000001')\n                    if quantity<=0 or quantity>=p.quantity:raise ValidationError('position reduction rounds to unsupported simulator quantity')\n                    partials=[(('PYTHON',bar.end_ms),quantity)]\n            command={'effective_ms':bar.end_ms,'stop':candidate,'partials':partials,'close':close,'partial_reason':'PYTHON_REDUCTION_NEXT_OPEN'}\n            if 'target' in decision:\n                value=decision['target']\n                value=None if value is None else decimal(value,'updated target','.000000000000000001','1000000000000000')\n                if value is not None and ((p.side=='LONG' and value<=p.entry_price) or (p.side=='SHORT' and value>=p.entry_price)):raise ValidationError('target must be on the profitable side of entry')\n                command['target']=value\n            p.scheduled=command\n        return PythonSignal(bar.symbol,bar.end_ms,side,'PYTHON_ON_COMPLETED_BAR',Decimal('.0001'),None,stop,target)\n\n    def evaluate(self,history):\n        b=history[-1]\n        try:return self.signals.pop(b.symbol)\n        except KeyError:raise ValidationError('Python evaluation was not supplied a causal account snapshot') from None\n", "backtester/python_sandbox_runner.py": "\"\"\"Runs ONLY inside the unprivileged, secret-free, network-disabled container.\n\nNo application imports, database client or project mount is present here.\nSecurity is the container boundary, not restrictions on Python builtins/AST.\n\"\"\"\nfrom collections import deque,namedtuple\nfrom decimal import Decimal,localcontext\nimport contextlib\nimport json\nimport os\nimport sys\nfrom types import SimpleNamespace\n\nCandle=namedtuple('Candle','symbol open_ms interval_ms open high low close volume')\n\n\ndef encode(x):\n    if isinstance(x,Decimal):return str(x)\n    raise TypeError('strategy decisions must be dictionaries containing finite numbers, strings, booleans or null')\n\n\nclass Context:\n    def __init__(self,row,history,state):\n        self.symbol=row['symbol'];self.history=tuple(history);self.state=state\n        self.bar=history[-1];self.close=self.bar.close;self.timestamp_ms=self.bar.open_ms+self.bar.interval_ms\n        self.account=SimpleNamespace(**{k:Decimal(str(v)) for k,v in row['account'].items()})\n        self.position=None\n        if row['position']:\n            p=dict(row['position'])\n            for k in ['entry_price','quantity','original_quantity','stop','initial_stop','unrealized_fraction','planned_risk','mfe','mae']:\n                p[k]=Decimal(str(p[k]))\n            if p.get('target') is not None:p['target']=Decimal(str(p['target']))\n            self.position=SimpleNamespace(**p)\n            key=p['trade_id']\n        else:key=None\n        if state.get('__position_id')!=key:state.clear();state['__position_id']=key\n\n    def sma(self,period):\n        if type(period) is not int or not 1<=period<=len(self.history):raise ValueError('SMA period exceeds supplied completed history; increase WARMUP_BARS')\n        return sum((b.close for b in self.history[-period:]),Decimal(0))/period\n\n    def atr(self,period):\n        if type(period) is not int or not 1<=period<len(self.history):raise ValueError('ATR needs period+1 completed candles; increase WARMUP_BARS')\n        h=self.history\n        return sum((max(h[i].high-h[i].low,abs(h[i].high-h[i-1].close),abs(h[i].low-h[i-1].close)) for i in range(len(h)-period,len(h))),Decimal(0))/period\n\n    def enter(self,side,*,stop_fraction=None,stop_distance=None,stop_price=None,target_fraction=None,target_distance=None,target_price=None):\n        def rule(fraction,distance,price,required):\n            fields=[(k,v) for k,v in [('fraction',fraction),('distance',distance),('price',price)] if v is not None]\n            if not fields and not required:return None\n            if len(fields)!=1:raise ValueError('choose exactly one stop/target fraction, distance or absolute price')\n            k,v=fields[0];return {'mode':k,'value':str(v)}\n        return {'enter':{'side':side,'stop':rule(stop_fraction,stop_distance,stop_price,True),'target':rule(target_fraction,target_distance,target_price,False)}}\n\n    def exit(self):return {'close':True}\n    def manage(self,**kwargs):return kwargs\n\n\ndef send(value):\n    text=json.dumps(value,default=encode,separators=(',',':'),allow_nan=False)\n    if len(text.encode())>65536:raise ValueError('strategy response exceeds 64KiB')\n    sys.stdout.write(text+'\\n');sys.stdout.flush()\n\n\ndef main():\n    histories={};states={}\n    namespace={'__name__':'strategy','__file__':'/strategy.py'}\n    try:\n        # User stdout cannot corrupt normal protocol output. Direct os.write is\n        # still untrusted protocol input and is rejected/bounded by the broker.\n        with open(os.devnull,'w') as sink,contextlib.redirect_stdout(sink):\n            exec(compile(open('/strategy.py').read(),'strategy.py','exec'),namespace)\n        if not callable(namespace.get('on_bar')):raise ValueError('on_bar(ctx) is not callable')\n        warmup=namespace.get('WARMUP_BARS',100)\n        if type(warmup) is not int or not 2<=warmup<=501:raise ValueError('WARMUP_BARS must remain a literal integer from 2 to 501')\n        send({'ready':True,'api':'HKS_PYTHON/1','warmup_bars':warmup})\n    except BaseException as e:\n        send({'error':type(e).__name__+': '+str(e)[:500]});return\n    for line in sys.stdin.buffer:\n        sequence=None\n        try:\n            if len(line)>512*1024:raise ValueError('input frame exceeds 512KiB')\n            row=json.loads(line);sequence=row['seq'];sym=row['symbol']\n            h=histories.setdefault(sym,deque(maxlen=warmup))\n            for b in row['bars']:\n                candle=Candle(sym,b['open_ms'],b['interval_ms'],*(Decimal(b[k]) for k in ['open','high','low','close','volume']))\n                if h and candle.open_ms!=h[-1].open_ms+h[-1].interval_ms:raise ValueError('noncontiguous completed history')\n                h.append(candle)\n            if len(h)<warmup:raise ValueError('insufficient completed warm-up')\n            with localcontext() as ctx:\n                ctx.prec=34\n                context=Context(row,h,states.setdefault(sym,{}))\n                with open(os.devnull,'w') as sink,contextlib.redirect_stdout(sink):decision=namespace['on_bar'](context)\n            send({'seq':sequence,'decision':decision})\n        except BaseException as e:\n            send({'seq':sequence,'error':type(e).__name__+': '+str(e)[:500]});return\n\n\nif __name__=='__main__':main()\n", "backtester/reports.py": "\"\"\"Computed reports. Aggregate independent wallets are not one account's ROI.\"\"\"\nimport csv\nfrom decimal import Decimal, localcontext\nimport io\n\nfrom .common import primitives, utc\n\nZERO = Decimal(0)\n\n\ndef _sum(rows, key):\n    return sum((Decimal(str(t[key])) for t in rows), ZERO)\n\n\ndef _performance(trades):\n    values = [Decimal(t[\"net_pnl\"]) for t in trades]\n    wins = [x for x in values if x > 0]\n    losses = [x for x in values if x < 0]\n    return {\"closed_trades\": len(trades), \"wins\": len(wins), \"losses\": len(losses),\n            \"breakeven\": len(values) - len(wins) - len(losses),\n            \"win_rate_pct\": (Decimal(len(wins)) / len(values) * 100) if values else None,\n            \"gross_pnl_after_slippage\": _sum(trades, \"gross_pnl\"),\n            \"fees_closed_trades\": _sum(trades, \"fees\"), \"slippage_already_in_pnl\": _sum(trades, \"slippage_cost\"),\n            \"realized_net_pnl\": _sum(trades, \"net_pnl\"),\n            \"average_net_win\": sum(wins, ZERO) / len(wins) if wins else None,\n            \"average_net_loss\": sum(losses, ZERO) / len(losses) if losses else None,\n            \"expectancy_closed\": sum(values, ZERO) / len(values) if values else None,\n            \"mean_mfe_pct\": _sum(trades, \"mfe_pct\") / len(trades) if trades else None,\n            \"mean_mae_pct\": _sum(trades, \"mae_pct\") / len(trades) if trades else None,\n            \"long_trades\": sum(t[\"side\"] == \"LONG\" for t in trades),\n            \"short_trades\": sum(t[\"side\"] == \"SHORT\" for t in trades)}\n\n\ndef build_reports(result):\n    with localcontext() as ctx:\n        ctx.prec = 34\n        return _build_reports(result)\n\n\ndef _build_reports(result):\n    by_coin = []\n    for sym in result[\"symbols\"]:\n        trades = [t for t in result[\"trades\"] if t[\"symbol\"] == sym]\n        opened = [p for p in result[\"open_positions\"] if p[\"symbol\"] == sym]\n        account = result[\"accounts\"].get(sym) if result[\"config\"][\"mode\"] == \"individual\" else None\n        row = {\"symbol\": sym, **result[\"signal_counts\"][sym], **_performance(trades),\n               \"open_trades\": len(opened), \"unrealized_pnl\": _sum(opened, \"unrealized_pnl\"),\n               \"open_entry_fees\": _sum(opened, \"entry_fee\"),\n               \"starting_capital\": None if account is None else account[\"initial_capital\"],\n               \"ending_equity\": None if account is None else account[\"ending_equity\"],\n               \"drawdown\": None if account is None else account[\"max_drawdown\"],\n               \"drawdown_scope\": \"INDEPENDENT_ACCOUNT\" if account else \"NOT_AN_INDEPENDENT_SHARED_COIN_WALLET\"}\n        row[\"exit_reasons\"] = {reason:sum(t[\"exit_reason\"]==reason for t in trades) for reason in sorted({t[\"exit_reason\"] for t in trades})}\n        by_coin.append(row)\n    start = sum((Decimal(a[\"initial_capital\"]) for a in result[\"accounts\"].values()), ZERO)\n    end = sum((Decimal(a[\"ending_equity\"]) for a in result[\"accounts\"].values()), ZERO)\n    if result[\"config\"][\"mode\"] == \"shared\":\n        drawdown = Decimal(result[\"accounts\"][\"SHARED\"][\"max_drawdown\"])\n    else:\n        # Combine contemporaneous independent account values, never transiently mix\n        # account updates into a fictitious capital allocation sequence.\n        snapshots = {}\n        for row in result[\"equity_curve\"]:\n            snapshots.setdefault(row[\"timestamp_ms\"], {})[row[\"account\"]] = Decimal(row[\"equity\"])\n        current = {name: Decimal(a[\"initial_capital\"]) for name,a in result[\"accounts\"].items()}\n        peak, drawdown = start, ZERO\n        for ts in sorted(snapshots):\n            current.update(snapshots[ts]); value = sum(current.values(), ZERO)\n            peak = max(peak, value); drawdown = max(drawdown, peak-value)\n    counts = {}\n    monthly = {}\n    for trade in result[\"trades\"]:\n        counts[trade[\"exit_reason\"]] = counts.get(trade[\"exit_reason\"], 0) + 1\n        monthly.setdefault(utc(trade[\"exit_ms\"])[:7], []).append(trade)\n    total = {**_performance(result[\"trades\"]), \"starting_capital\": start, \"ending_equity\": end,\n             \"net_equity_change\": end - start,\n             \"return_on_total_starting_capital_pct\": (end-start)/start*100,\n             \"capital_scope\": \"ONE_SHARED_ACCOUNT\" if result[\"config\"][\"mode\"] == \"shared\" else \"SUM_OF_INDEPENDENT_SYMBOL_ACCOUNTS\",\n             \"open_trades\": len(result[\"open_positions\"]), \"unrealized_pnl\": _sum(result[\"open_positions\"],\"unrealized_pnl\"),\n             \"open_entry_fees\": _sum(result[\"open_positions\"],\"entry_fee\"),\n             \"available_cash\": sum((Decimal(a[\"available_cash\"]) for a in result[\"accounts\"].values()),ZERO),\n             \"reserved_capital\": sum((Decimal(a[\"reserved_capital\"]) for a in result[\"accounts\"].values()),ZERO),\n             \"reserved_risk\": sum((Decimal(a[\"reserved_risk\"]) for a in result[\"accounts\"].values()),ZERO),\n             \"max_drawdown\": drawdown, \"drawdown_scope\": \"SAMPLED_EQUITY_NOT_TICK_PRECISION\",\n             \"qualified_signals\": sum(c[\"qualified_signals\"] for c in result[\"signal_counts\"].values()),\n             \"rejected_entries\": sum(sum(c[\"rejections\"].values()) for c in result[\"signal_counts\"].values()),\n             \"ambiguous_stop_target\": sum(bool(t[\"ambiguous_stop_target\"]) for t in result[\"trades\"])}\n    return primitives({\"summary\": total, \"coins\": by_coin, \"exit_reasons\": counts,\n                       \"monthly_realized_by_exit\": [{\"month_utc\": m, **_performance(rows)} for m,rows in sorted(monthly.items())]})\n\n\nTRADE_COLUMNS = (\"trade_id\", \"symbol\", \"side\", \"state\", \"entry_utc\", \"exit_utc\", \"entry_price\", \"exit_price\",\n                 \"quantity\", \"notional\", \"margin\", \"risk_budget\", \"planned_risk\", \"initial_stop\", \"stop\", \"target\",\n                 \"gross_pnl\", \"fees\", \"slippage_cost\", \"net_pnl\", \"mfe_pct\", \"mae_pct\", \"exit_reason\",\n                 \"holding_minutes\", \"timestamp_precision\", \"ambiguous_stop_target\", \"strategy_version\")\nCOIN_COLUMNS = (\"symbol\", \"starting_capital\", \"qualified_signals\", \"closed_trades\", \"open_trades\", \"long_trades\", \"short_trades\",\n                \"wins\", \"losses\", \"win_rate_pct\", \"gross_pnl_after_slippage\", \"fees_closed_trades\", \"slippage_already_in_pnl\",\n                \"realized_net_pnl\", \"unrealized_pnl\", \"open_entry_fees\", \"ending_equity\", \"drawdown\", \"drawdown_scope\",\n                \"mean_mfe_pct\",\"mean_mae_pct\",\"average_net_win\",\"average_net_loss\",\"expectancy_closed\",\"rejections\",\"exit_reasons\")\n\n\ndef _safe_cell(value):\n    if value is None:\n        return \"\"\n    if isinstance(value,(dict,list)):\n        from .common import canonical\n        value=canonical(value)\n    value = str(value)\n    if value.startswith((\"=\", \"+\", \"-\", \"@\", \"\\t\", \"\\r\", \"\\n\")):\n        try:\n            numeric = Decimal(value)\n            if not numeric.is_finite(): raise ValueError\n        except (ValueError, ArithmeticError):\n            value = \"'\" + value\n    return value\n\n\ndef csv_report(result, kind):\n    if kind == \"trades\":\n        columns = TRADE_COLUMNS\n        rows = [t | {\"entry_utc\": utc(t[\"entry_ms\"]), \"exit_utc\": utc(t[\"exit_ms\"]),\n                     \"holding_minutes\": Decimal(t[\"holding_ms\"]) / 60_000} for t in result[\"trades\"]]\n    elif kind == \"coins\":\n        columns, rows = COIN_COLUMNS, build_reports(result)[\"coins\"]\n    elif kind == \"decisions\":\n        columns = (\"signal_ms\",\"symbol\",\"side\",\"outcome\",\"reason\",\"execution_ms\",\"trade_id\")\n        rows = result[\"decisions\"]\n    else:\n        raise ValueError(\"unsupported CSV kind\")\n    output = io.StringIO(newline=\"\")\n    writer = csv.DictWriter(output,fieldnames=columns,extrasaction=\"ignore\")\n    writer.writeheader()\n    for row in rows: writer.writerow({k:_safe_cell(row.get(k)) for k in columns})\n    return output.getvalue()\n", "backtester/simulation.py": "\"\"\"Causal common-interval replay. No exchange calls and no executable user code.\"\"\"\nfrom collections import defaultdict, deque\nfrom dataclasses import asdict\nfrom decimal import Decimal, localcontext\nfrom heapq import merge\nfrom itertools import groupby\nimport time\n\nfrom .common import INTERVALS, decimal, digest, primitives\nfrom .data import coverage\nfrom .errors import ResourceLimit, ValidationError\nfrom .models import Signal\nfrom .portfolio import Account, ZERO\n\nMAX_TRADES = 10_000\nMAX_SECONDS = 30\n\n\ndef _check_signal(signal, bar):\n    if not isinstance(signal, Signal) or signal.symbol != bar.symbol or signal.timestamp_ms != bar.end_ms:\n        raise ValidationError(\"strategy returned a signal with invalid symbol or completion timestamp\")\n    if signal.side not in (\"LONG\", \"SHORT\", \"NO_SIGNAL\") or not isinstance(signal.reason, str) or len(signal.reason) > 240:\n        raise ValidationError(\"invalid signal side/reason\")\n    if not isinstance(signal.stop_fraction, Decimal) or (signal.target_fraction is not None and not isinstance(signal.target_fraction,Decimal)):\n        raise ValidationError(\"signal stop/target distances must be Decimal values\")\n    decimal(signal.stop_fraction, \"signal stop_fraction\", \".0001\", \".5\")\n    if signal.target_fraction is not None:\n        decimal(signal.target_fraction, \"signal target_fraction\", \".0001\", \"2\")\n        if signal.side == \"SHORT\" and signal.target_fraction >= 1:\n            raise ValidationError(\"SHORT target price must be positive\")\n\n\ndef _stop_at_open(account, bar, config):\n    p = account.positions.get(bar.symbol)\n    if p is None or bar.volume <= 0:\n        return None\n    stop = bar.open <= p.stop if p.side == \"LONG\" else bar.open >= p.stop\n    target = p.target is not None and (bar.open >= p.target if p.side == \"LONG\" else bar.open <= p.target)\n    if stop:\n        p.mae = max(p.mae, (p.entry_price - bar.open) if p.side == \"LONG\" else (bar.open - p.entry_price))\n        return account.close(p, bar.open, bar.open_ms, config, \"STOP_GAP\", (bar.open_ms, bar.open_ms))\n    if target:\n        # No favorable opening-gap windfall; market-trigger model at target minus adverse slippage.\n        return account.close(p, p.target, bar.open_ms, config, \"TARGET_GAP_CONSERVATIVE\", (bar.open_ms, bar.open_ms))\n    return None\n\n\ndef _intrabar(account, bar, config):\n    p = account.positions.get(bar.symbol)\n    if p is None:\n        return None\n    is_long = p.side == \"LONG\"\n    stop = bar.low <= p.stop if is_long else bar.high >= p.stop\n    target = p.target is not None and (bar.high >= p.target if is_long else bar.low <= p.target)\n    if bar.volume <= 0:\n        return {\"symbol\": bar.symbol, \"timestamp_ms\": bar.end_ms, \"reason\": \"STOP_OR_TARGET_UNFILLED_ZERO_VOLUME\"} if stop or target else None\n    if stop or target:\n        # Unknown path through the candle: stop wins. Excursions bounded to prices\n        # certainly reached through the chosen trigger, not later candle extrema.\n        raw = p.stop if stop else p.target\n        p.mfe = max(p.mfe, (raw - p.entry_price) if is_long else (p.entry_price - raw), ZERO)\n        p.mae = max(p.mae, (p.entry_price - raw) if is_long else (raw - p.entry_price), ZERO)\n        account.close(p, raw, bar.end_ms, config,\n                      \"STOP_AMBIGUOUS\" if stop and target else (\"INITIAL_STOP\" if stop else \"TARGET\"),\n                      (bar.open_ms, bar.end_ms), bool(stop and target))\n        return None\n    p.mfe = max(p.mfe, (bar.high - p.entry_price) if is_long else (p.entry_price - bar.low), ZERO)\n    p.mae = max(p.mae, (p.entry_price - bar.low) if is_long else (bar.high - p.entry_price), ZERO)\n    return None\n\n\ndef simulate(dataset, strategy, config, symbols=None, *, replay_io=None):\n    with localcontext() as context:\n        context.prec = 34\n        return _simulate(dataset, strategy, config, symbols, replay_io=replay_io)\n\n\ndef _simulate(dataset, strategy, config, symbols, *, replay_io=None):\n    started = time.monotonic()\n    if dataset.market == \"USDT_LINEAR_PERPETUAL\" and not config.allow_uncertified_futures:\n        raise ValidationError(\"Futures funding/filters/liquidation are unavailable; explicit allow_uncertified_futures=true required for DIAGNOSTIC price replay\")\n    selected = sorted(dataset.candles if symbols is None else symbols)\n    if not selected or len(selected) != len(set(selected)) or set(selected) - dataset.candles.keys():\n        raise ValidationError(\"select distinct available symbols\")\n    interval = INTERVALS[dataset.interval]\n    if config.start_ms % interval or config.end_ms % interval:\n        raise ValidationError(\"requested UTC boundaries must align with the candle interval\")\n    if not isinstance(strategy.warmup_bars, int) or not 1 <= strategy.warmup_bars <= 501:\n        raise ValidationError(\"strategy warmup bound exceeded\")\n    warmup_start = config.start_ms - strategy.warmup_bars * interval\n    for sym in selected:\n        rows = dataset.candles[sym]\n        if rows[0].open_ms > warmup_start or rows[-1].end_ms < config.end_ms:\n            raise ValidationError(f\"{sym}: requested period plus {strategy.warmup_bars} warm-up candles unavailable; no silent shortening\")\n    names = selected if config.mode == \"individual\" else [\"SHARED\"]\n    managed = bool(getattr(strategy, \"managed\", False))\n    from .studio_management import ManagedAccount, at_open, after_gap, at_close\n    account_type = ManagedAccount if managed else Account\n    accounts = {n: account_type(n, config.initial_capital, dataset.market, config.initial_capital,\n                           peak_equity=config.initial_capital) for n in names}\n    streaming=bool(getattr(replay_io,'streaming_trades',False))\n    if streaming:\n        for a in accounts.values():a.closed=replay_io.closed_ledger()\n    histories = {s: deque(maxlen=strategy.warmup_bars) for s in selected}\n    pending, seen, last_bars = {}, set(), {}\n    journal, equity, warnings = [], [], list(dataset.warnings)\n    if replay_io is not None:\n        journal = replay_io.journal(\"decisions\")\n        equity = replay_io.equity_sink(accounts, config)\n    counts = {s: {\"evaluations\": 0, \"no_signal\": 0, \"qualified_signals\": 0, \"rejections\": {}} for s in selected}\n    position_count = 0\n\n    def account_for(sym):\n        return accounts[sym if config.mode == \"individual\" else \"SHARED\"]\n\n    def decision(signal, outcome, reason, **extra):\n        if outcome == \"REJECTED\":\n            d = counts[signal.symbol][\"rejections\"]\n            d[reason] = d.get(reason, 0) + 1\n        journal.append({\"signal_ms\": signal.timestamp_ms, \"symbol\": signal.symbol,\n                        \"side\": signal.side, \"signal_reason\": signal.reason,\n                        \"outcome\": outcome, \"reason\": reason, **extra})\n\n    streams = ((b for b in dataset.candles[s] if warmup_start <= b.open_ms < config.end_ms) for s in selected)\n    events = merge(*streams, key=lambda b: (b.open_ms, b.symbol))\n    for ts, values in groupby(events, key=lambda b: b.open_ms):\n        if time.monotonic() - started > (MAX_SECONDS if replay_io is None else replay_io.max_seconds):\n            raise ResourceLimit(\"replay wall budget exceeded; no completed result accepted\")\n        bars = sorted(values, key=lambda b: b.symbol)\n        # Every account sees only contemporaneously known opens during allocation.\n        for b in bars:\n            account_for(b.symbol).marks[b.symbol] = b.open\n        for b in bars:\n            if managed: at_open(account_for(b.symbol), b, config)\n            _stop_at_open(account_for(b.symbol), b, config)\n            if managed: after_gap(account_for(b.symbol), b, config)\n        if ts >= config.start_ms:\n            equity.extend(a.observe_equity(ts) for a in accounts.values())\n        attempted = []\n        for b in bars:\n            a = account_for(b.symbol)\n            signal = pending.pop(b.symbol, None)\n            if signal is not None:\n                if ts != signal.timestamp_ms:\n                    raise ValidationError(\"next available bar is not contiguous with signal\")\n                entry_equity = a.equity()\n                p, reason = a.enter(signal, b, config, strategy.version_id)\n                if p is None:\n                    decision(signal, \"REJECTED\", reason, execution_ms=ts)\n                else:\n                    attempted.append((a,b,signal,p,entry_equity,a.cash,a.reserved()))\n        # Current candle volume is only known at completion. A zero-volume\n        # attempted fill is cancelled AFTER simultaneous orders have reserved\n        # funds, never used as future knowledge to free cash for another symbol.\n        for a,b,signal,p,entry_equity,cash_after,reserved in attempted:\n            if b.volume <= 0:\n                a.cash += p.margin + p.entry_fee\n                del a.positions[p.symbol]\n                decision(signal,\"REJECTED\",\"ENTRY_UNFILLED_ZERO_VOLUME\",execution_ms=b.end_ms,order_submitted_ms=ts)\n                continue\n            position_count += 1\n            limit=MAX_TRADES if not streaming else replay_io.max_entries\n            if position_count > limit:\n                raise ResourceLimit(format(limit,',')+\"-entry replay bound exceeded; no partial result\")\n            decision(signal, \"ENTERED\", \"ACCEPTED\", execution_ms=ts, trade_id=p.trade_id,\n                     equity_before=entry_equity,cash_after=cash_after,reserved_capital=reserved,\n                     quantity=p.quantity,planned_risk=p.planned_risk,risk_budget=p.risk_budget)\n        for b in bars:\n            note = _intrabar(account_for(b.symbol), b, config)\n            if note:\n                if replay_io is None:\n                    warnings.append(f\"{b.symbol} {b.end_ms}: {note['reason']}\")\n                else:\n                    replay_io.journal(\"warnings\").append(note)\n        for b in bars:\n            account_for(b.symbol).marks[b.symbol] = b.close\n            last_bars[b.symbol] = b\n        end = ts + interval\n        if end >= config.start_ms:\n            equity.extend(a.observe_equity(end) for a in accounts.values())\n        for b in bars:\n            h = histories[b.symbol]\n            h.append(b)\n            if managed:\n                if getattr(strategy,'python_runtime',False):strategy.after_close(account_for(b.symbol),b,tuple(h))\n                else:at_close(account_for(b.symbol), b, tuple(h), strategy)\n            if b.end_ms < config.start_ms or len(h) < strategy.warmup_bars:\n                continue\n            signal = strategy.evaluate(tuple(h))\n            _check_signal(signal, b)\n            counts[b.symbol][\"evaluations\"] += 1\n            if signal.side == \"NO_SIGNAL\":\n                counts[b.symbol][\"no_signal\"] += 1\n                continue\n            counts[b.symbol][\"qualified_signals\"] += 1\n            key = (signal.symbol, signal.timestamp_ms)\n            repeated = key in seen if replay_io is None else replay_io.duplicate(signal)\n            if repeated:\n                decision(signal, \"REJECTED\", \"DUPLICATE_SIGNAL_CANDLE\")\n                continue\n            if replay_io is None:\n                seen.add(key)\n            if b.end_ms >= config.end_ms:\n                decision(signal, \"REJECTED\", \"NO_NEXT_BAR_INSIDE_TEST\")\n            else:\n                pending[b.symbol] = signal\n\n    if config.end_policy == \"CLOSE_AT_LAST_CLOSE\":\n        for a in accounts.values():\n            for p in list(a.positions.values()):\n                last = last_bars[p.symbol]\n                if last.volume <= 0:\n                    warnings.append(f\"{p.symbol}: requested end close unfilled due to zero recorded volume; remains OPEN\")\n                    continue\n                a.close(p, a.marks[p.symbol], config.end_ms, config, \"END_OF_TEST_EXPLICIT\", (config.end_ms, config.end_ms))\n            equity.append(a.observe_equity(config.end_ms))\n    reconciliation = {n: a.reconcile() for n, a in accounts.items()}\n    if any(abs(r[k]) > Decimal(\"1e-20\") for r in reconciliation.values() for k in (\"cash_residual\", \"equity_residual\")):\n        raise ArithmeticError(\"wallet reconciliation failed\")\n    result = {\"schema_version\": 1, \"engine_version\": \"OFFLINE_REPLAY_V1\",\n              \"label\": \"SYNTHETIC ENGINE VERIFICATION\" if dataset.synthetic else \"DECLARED HISTORICAL PRICE REPLAY \u2014 NOT CERTIFIED EXECUTION\",\n              \"strategy_parity\": \"HKS NORMAL/REVERSE NOT VERIFIED\",\n              \"strategy_version\": strategy.version_id, \"strategy_hash\": strategy.content_hash,\n              \"dataset_hash\": dataset.content_hash, \"input_hashes\": dataset.input_hashes,\n              \"dataset_id\": dataset.dataset_id, \"exchange\": dataset.exchange, \"market\": dataset.market,\n              \"source\": dataset.source, \"retrieved_at\": dataset.retrieved_at, \"synthetic\": dataset.synthetic,\n              \"config\": asdict(config), \"symbols\": selected,\n              \"coverage\": [c for c in coverage(dataset) if c[\"symbol\"] in selected],\n              \"decisions\": sorted(journal,key=lambda d:(d[\"signal_ms\"],d[\"symbol\"])) if replay_io is None else [], \"signal_counts\": counts,\n              \"trades\": [] if streaming else sorted([t for a in accounts.values() for t in a.closed], key=lambda t: (t[\"exit_ms\"], t[\"symbol\"], t[\"trade_id\"])),\n              \"open_positions\": [asdict(p) | {\"mark_price\": a.marks[p.symbol], \"unrealized_pnl\": a.unrealized(p)}\n                                 for a in accounts.values() for p in a.positions.values()],\n              \"accounts\": {n: {\"initial_capital\": a.initial, \"available_cash\": a.cash,\n                                \"reserved_capital\": a.reserved(), \"reserved_risk\": a.reserved_risk(),\n                                \"ending_equity\": a.equity(), \"max_drawdown\": a.max_drawdown,\n                                \"max_drawdown_fraction\": a.max_drawdown_fraction} for n, a in accounts.items()},\n              \"equity_curve\": equity if replay_io is None else [], \"reconciliation\": reconciliation,\n              \"warnings\": sorted(set(warnings + [\n                  \"Illustrative SMA/static-stop rules only; authentic Normal/Reverse and original trailing parity NOT VERIFIED.\",\n                  \"Fees/slippage are supplied assumptions. Slippage is already included in fill PnL: do NOT subtract it again.\",\n                  \"Quantity rounds down to 1e-8 simulator units; this is NOT a historical exchange lot/tick filter.\",\n                  \"OHLC path unknown: stop before target; stop/target fills use interval-only timestamps; MFE/MAE on exit candles are conservative observed bounds.\",\n                  \"Same-time orders: gap exits, then alphabetic symbol entries, then intrabar exits. Same-bar intrabar proceeds cannot fund simultaneous entries.\",\n                  \"Zero-volume attempted entries cancel at candle completion; simultaneous orders cannot use the subsequently released reservation.\",\n                  \"Drawdown is sampled at common candle closes/opening gaps, not tick-level intrabar drawdown.\",\n                  \"Positive recorded candle volume does not prove your order could fill. No order-book or latency certification.\",\n                  \"No scaling, partial exits, trailing, liquidations, funding, live strategy activation or exchange orders implemented.\"\n              ]))}\n    if managed:\n        result[\"engine_version\"] = \"STUDIO_MANAGEMENT_V1\"\n        result[\"warnings\"] = [w for w in result[\"warnings\"] if not w.startswith((\"Illustrative SMA/static\", \"No scaling, partial\"))]\n        result[\"warnings\"].extend([\n            \"STUDIO_RULES is a restricted data-only language, not arbitrary Python/JavaScript or private HKS strategies.\",\n            \"ATR is a completed-bar simple mean of true ranges; stop fraction is computed at signal 