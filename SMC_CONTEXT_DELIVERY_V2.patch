args; end = len(bars)-offset-shift\n        if op == \"sma\": return sum((b.close for b in bars[end-period:end]), Decimal(0))/period\n        return sum((max(bars[i].high-bars[i].low, abs(bars[i].high-bars[i-1].close), abs(bars[i].low-bars[i-1].close)) for i in range(end-period, end)), Decimal(0))/period\n    a, b = (number(x, bars, shift) for x in args)\n    if op == \"add\": return a+b\n    if op == \"sub\": return a-b\n    if op == \"mul\": return a*b\n    if b == 0: raise ValidationError(\"strategy expression divides by zero; no successful result accepted\")\n    return a/b\n\n\ndef condition(expr, bars):\n    if type(expr) is bool: return expr\n    op, args = expr[0], expr[1:]\n    if op == \"and\": return all(condition(a, bars) for a in args)\n    if op == \"or\": return any(condition(a, bars) for a in args)\n    if op == \"not\": return not condition(args[0], bars)\n    a,b = (number(x,bars) for x in args)\n    if op in {\"cross_above\", \"cross_below\"}:\n        pa,pb = (number(x,bars,1) for x in args)\n        return (pa<=pb and a>b) if op==\"cross_above\" else (pa>=pb and a<b)\n    return {\"gt\":a>b, \"gte\":a>=b, \"lt\":a<b, \"lte\":a<=b, \"eq\":a==b}[op]\n\n\n@dataclass(frozen=True)\nclass StudioStrategy:\n    definition: dict\n    content_hash: str\n    managed: bool = True\n\n    @property\n    def warmup_bars(self): return warmup(self.definition)\n    @property\n    def version_id(self): return \"STUDIO_RULES_\"+self.content_hash\n\n    def evaluate(self, history):\n        d=self.definition; b=history[-1]; stop=d[\"stop\"]\n        fraction = Decimal(str(stop[\"fraction\"])) if stop[\"type\"]==\"fixed\" else number([\"atr\",stop[\"period\"],0],history)*Decimal(str(stop[\"multiple\"]))/b.close\n        if not Decimal('.0001') <= fraction <= Decimal('.5'):\n            return Signal(b.symbol,b.end_ms,\"NO_SIGNAL\",\"ATR_STOP_OUTSIDE_SUPPORTED_BOUNDS\",Decimal('.0001'))\n        long=condition(d.get(\"long\",False),history); short=condition(d.get(\"short\",False),history)\n        side = \"NO_SIGNAL\" if long==short else (\"LONG\" if long else \"SHORT\")\n        return Signal(b.symbol,b.end_ms,side,\"CONFLICTING_DIRECTIONS\" if long and short else \"STRUCTURED_RULE\",fraction,\n                      None if d.get(\"target_fraction\") is None else Decimal(str(d[\"target_fraction\"])))\n\n\ndef build(raw):\n    value=validate(raw)\n    return StudioStrategy(value,digest(value))\n\n\nEXAMPLE = {\"schema_version\":1,\"kind\":\"STUDIO_RULES\",\"name\":\"Editable SMA crossover example (not private HKS)\",\n           \"long\":[\"cross_above\",[\"sma\",5,0],[\"sma\",20,0]],\"short\":False,\n           \"exit_long\":[\"cross_below\",[\"sma\",5,0],[\"sma\",20,0]],\n           \"stop\":{\"type\":\"fixed\",\"fraction\":\"0.02\"},\"target_fraction\":None,\n           \"management\":{\"trailing\":{\"activate_fraction\":\"0.03\",\"distance_fraction\":\"0.015\"},\n                         \"partials\":[{\"profit_fraction\":\"0.04\",\"close_fraction\":\"0.25\"}],\"max_hold_bars\":180}}\n", "browser_adapter.py": "\"\"\"Browser-only IO seam. V4 Decimal, validation and accounting remain untouched.\n\nThe JavaScript function is supplied by the trusted financial Web Worker. User\nPython is in another interpreter in an opaque-origin worker and has no reference\nto this interpreter, its memory, source, storage, or result objects.\n\"\"\"\nimport json, sys, types\nfrom pathlib import Path\n\nshim=types.ModuleType('backtester.python_sandbox')\nclass UnusedRPC:\n    def __init__(self,*args):raise RuntimeError('No host/subprocess sandbox in browser')\nshim.RPC=UnusedRPC\nsys.modules['backtester.python_sandbox']=shim\nfrom backtester.python_runtime import PythonRuntime\nfrom backtester.python_definition import build\nfrom backtester.data import load_dataset\nfrom backtester.config import RunConfig\nfrom backtester.simulation import simulate\nfrom backtester.common import canonical, timestamp\nfrom browser_stream import chunks\nfrom backtester.browser_context import CompletedContext, requirements, CONTRACT\n\nclass BrowserRPC:\n    def __init__(self, context=None):self.context=context;self.last_exit=None\n    def call(self,frame):\n        import js\n        if self.context is not None:\n            last=frame['bars'][-1]\n            frame={**frame,'contexts':self.context.at(frame['symbol'],last['open_ms']+last['interval_ms']),\n                   'last_exit':self.last_exit}\n        if len(canonical(frame).encode())>512*1024:raise ValueError('512KiB completed-context frame bound exceeded')\n        answer=json.loads(str(js.strategy_call(canonical(frame))))\n        if 'error' in answer:raise ValueError(answer['error'])\n        return answer['decision']\n\nclass BrowserRuntime(PythonRuntime):\n    def __init__(self,definition,dataset=None,start_ms=None):\n        spec=build(definition)\n        self.definition=spec.definition;self.content_hash=spec.content_hash\n        self.version_id=spec.version_id;self.warmup_bars=spec.warmup_bars\n        requested,needed=requirements(spec.definition,spec.warmup_bars)\n        if requested and (dataset is None or start_ms is None):raise ValueError('Declared multi-timeframe context needs its verified dataset and UTC start')\n        context=CompletedContext(dataset,requested,needed,start_ms) if requested else None\n        self.rpc=BrowserRPC(context);self.previous={};self.signals={}\n        self._closed_offsets={};self._last_exits={}\n\n    def after_close(self,account,bar,history):\n        # Read-only execution evidence, including positions stopped within their\n        # first minute. Rebuild from the restored ledger on a fresh runtime;\n        # never infer exits from an absence of positions or mutate the ledger.\n        if getattr(self.rpc,'context',None) is not None:\n            key=id(account);offset=self._closed_offsets.get(key,0)\n            for row in account.closed[offset:]:\n                self._last_exits[key,row['symbol']]={k:row[k] for k in\n                    ('exit_ms','fill_window_start_ms','fill_window_end_ms','exit_reason')}\n            self._closed_offsets[key]=len(account.closed)\n            self.rpc.last_exit=self._last_exits.get((key,bar.symbol))\n        return super().after_close(account,bar,history)\n\ndef run_browser(raw):\n    try:\n        bundle=json.loads(raw);root=Path('/input');root.mkdir(exist_ok=True)\n        manifest=bundle['manifest'];files=bundle['files']\n        if not isinstance(files,dict) or len(files)>20:raise ValueError('1\u201320 input files required')\n        if sum(len(x.encode()) for x in files.values())>32*1024**2:raise ValueError('32MiB proof input bound')\n        for name,value in files.items():\n            if Path(name).name!=name or not name.endswith('.csv'):raise ValueError('unsafe candle filename')\n            (root/name).write_text(value)\n        (root/'manifest.json').write_text(canonical(manifest))\n        ds=load_dataset(root,as_of_ms=timestamp('2026-10-17T00:00:00Z'))\n        config=RunConfig.from_dict(bundle['config'])\n        result=simulate(ds,BrowserRuntime(bundle['definition'],ds,config.start_ms),config)\n        return canonical({'ok':True,'result':result})\n    except Exception as e:\n        return canonical({'ok':False,'error':str(e)[:700]})\n\n_stream = None\ndef start_stream(raw, checkpoint='null'):\n    global _stream\n    bundle=json.loads(raw);root=Path('/input');root.mkdir(exist_ok=True)\n    manifest=bundle['manifest'];files=bundle['files']\n    if not isinstance(files,dict) or not 1<=len(files)<=20:raise ValueError('1\u201320 input files required')\n    if sum(len(x.encode()) for x in files.values())>32*1024**2:raise ValueError('32MiB input bound; requested range is not silently shortened')\n    for name,value in files.items():\n        if Path(name).name!=name or not name.endswith('.csv'):raise ValueError('unsafe candle filename')\n        (root/name).write_text(value)\n    (root/'manifest.json').write_text(canonical(manifest))\n    dataset=load_dataset(root,as_of_ms=timestamp('2026-10-17T00:00:00Z'))\n    config=RunConfig.from_dict(bundle['config'])\n    _stream=chunks(dataset,BrowserRuntime(bundle['definition'],dataset,config.start_ms),config,\n                   json.loads(checkpoint),bundle.get('checkpoint_every',120))\n    return canonical({'loaded_candles':sum(len(x) for x in dataset.candles.values()),\n                      'dataset_hash':dataset.content_hash})\n\ndef next_stream():\n    value=next(_stream)\n    if value['kind']=='DONE':\n        from backtester.reports import build_reports\n        from backtester.studio_metrics import position_performance\n        from decimal import Decimal, localcontext\n        result=value['result']\n        with localcontext() as ctx:\n            ctx.prec=34\n            current={name:Decimal(row['initial_capital']) for name,row in result['accounts'].items()}\n            points={}\n            for row in result['equity_curve']:\n                current[row['account']]=Decimal(row['equity'])\n                points[row['timestamp_ms']]=sum(current.values(),Decimal(0))\n            rows=list(points.items());step=max(1,(len(rows)+598)//599)\n            selected=rows[::step]\n            if rows and (not selected or selected[-1]!=rows[-1]):selected.append(rows[-1])\n            value['view']={'reports':build_reports(result),\n                           'position_performance':position_performance(result),\n                           'warnings':[('Browser trusted-code worker execution, NOT an OS container. Legacy raw financial result/hash retained for parity; no exchange fills certified.' if w.startswith('Python runs in a separate secret-free OS container.') else w) for w in result['warnings']],\n                           'chart_sample':[{'timestamp_ms':ts,'equity':str(eq)} for ts,eq in selected]}\n    return canonical(value)\n\ndef validate_browser(raw):\n    spec=build(json.loads(raw))\n    requested,needed=requirements(spec.definition,spec.warmup_bars)\n    result={'definition':spec.definition,'version_id':spec.version_id,\n            'content_hash':spec.content_hash,'warmup_bars':spec.warmup_bars}\n    if requested:result.update(context_timeframes=requested,input_warmup_bars=needed,context_contract=CONTRACT)\n    return canonical(result)\n", "browser_stream.py": "\"\"\"Checkpoint orchestration around the pinned V4 loop, without financial edits.\n\nOnly loop scheduling changes: yield after a completed global timestamp, and\nrestore explicitly typed state before selecting the next chronological candle.\nFinancial checkpoint data is JSON, never pickle/code. Strategy snapshots are\nopaque and restored only in the isolated, trusted-code strategy worker.\n\"\"\"\nimport ast\nimport inspect\nimport json\nfrom collections import deque\nfrom dataclasses import fields\nfrom decimal import Decimal, localcontext\n\nfrom backtester import simulation\nfrom backtester.models import Candle, Position, Signal\nfrom backtester.python_definition import PythonSignal\nfrom backtester.portfolio import Account\nfrom backtester.studio_management import ManagedAccount\n\nTYPES = {t.__name__: t for t in (Candle, Position, Signal, PythonSignal, Account, ManagedAccount)}\nSTATE_NAMES = ('accounts', 'histories', 'pending', 'seen', 'last_bars', 'journal',\n               'equity', 'warnings', 'counts', 'position_count')\nMAX_CHECKPOINT = 64 * 1024 * 1024\n\ndef encode(value):\n    if value is None or type(value) in (str, int, bool):\n        return value\n    if isinstance(value, Decimal):\n        return {'@': 'decimal', 'v': str(value)}\n    if type(value) is list:\n        return [encode(x) for x in value]\n    if type(value) is dict:\n        if any(type(k) is not str for k in value):\n            raise ValueError('checkpoint dictionary keys must be strings')\n        return {'@': 'dict', 'v': [[k, encode(v)] for k, v in value.items()]}\n    if type(value) in (tuple, set, deque):\n        return {'@': type(value).__name__, 'v': [encode(x) for x in value],\n                'maxlen': value.maxlen if isinstance(value, deque) else None}\n    name = type(value).__name__\n    if TYPES.get(name) is not type(value):\n        raise ValueError('unsupported financial checkpoint type: ' + name)\n    return {'@': name, 'v': encode(vars(value))}\n\ndef decode(value, depth=0):\n    if depth > 60:\n        raise ValueError('checkpoint nesting limit')\n    if value is None or type(value) in (str, int, bool):\n        return value\n    if type(value) is list:\n        return [decode(x, depth + 1) for x in value]\n    if type(value) is not dict or set(value) - {'@', 'v', 'maxlen'}:\n        raise ValueError('invalid typed checkpoint')\n    kind, raw = value.get('@'), value.get('v')\n    dec = lambda v: decode(v, depth + 1)\n    if kind == 'decimal':\n        d = Decimal(raw)\n        if not d.is_finite():\n            raise ValueError('non-finite checkpoint decimal')\n        return d\n    if kind == 'dict':\n        if any(type(k) is not str for k, _ in raw) or len({k for k, _ in raw}) != len(raw):\n            raise ValueError('invalid checkpoint dictionary')\n        return {k: dec(v) for k, v in raw}\n    if kind in ('tuple', 'set', 'deque'):\n        values = [dec(x) for x in raw]\n        if kind == 'deque':\n            if type(value.get('maxlen')) is not int or not 1 <= value['maxlen'] <= 501:\n                raise ValueError('invalid history length')\n            return deque(values, maxlen=value['maxlen'])\n        return tuple(values) if kind == 'tuple' else set(values)\n    cls = TYPES.get(kind)\n    if cls is None:\n        raise ValueError('unrecognized checkpoint type')\n    attrs = dec(raw)\n    obj = cls(**{f.name: attrs[f.name] for f in fields(cls)})\n    for name, v in attrs.items():\n        if name.startswith('__'):\n            raise ValueError('unsafe checkpoint attribute')\n        object.__setattr__(obj, name, v)\n    return obj\n\ndef capture(scope, next_ms):\n    result = {'schema': 1, 'next_ms': next_ms,\n              'state': encode({name: scope[name] for name in STATE_NAMES}),\n              'runtime': encode({'previous': scope['strategy'].previous,\n                                 'signals': scope['strategy'].signals})}\n    raw = json.dumps(result, separators=(',', ':'))\n    if len(raw.encode()) > MAX_CHECKPOINT:\n        raise ValueError('64 MiB financial checkpoint bound exceeded; no truncated checkpoint')\n    return result\n\ndef restore(snapshot, strategy):\n    if snapshot.get('schema') != 1 or type(snapshot.get('next_ms')) is not int:\n        raise ValueError('unsupported checkpoint schema')\n    state = decode(snapshot['state'])\n    if set(state) != set(STATE_NAMES):\n        raise ValueError('incomplete financial checkpoint')\n    runtime = decode(snapshot['runtime'])\n    strategy.previous, strategy.signals = runtime['previous'], runtime['signals']\n    return state\n\ndef make_iterator():\n    \"\"\"Mechanical AST edits are tested against the entire pinned result object.\"\"\"\n    tree = ast.parse(inspect.getsource(simulation._simulate))\n    fn = tree.body[0]\n    fn.name = '_checkpoint_iterator'\n    fn.args.kwonlyargs += [ast.arg(arg='resume'), ast.arg(arg='checkpoint_every')]\n    fn.args.kw_defaults += [ast.Constant(None), ast.Constant(120)]\n    loop = next(n for n in fn.body if isinstance(n, ast.For) and isinstance(n.target, ast.Tuple)\n                and [getattr(x, 'id', None) for x in n.target.elts] == ['ts', 'values'])\n    before_streams = next(i for i, n in enumerate(fn.body) if isinstance(n, ast.Assign)\n                          and any(isinstance(t, ast.Name) and t.id == 'streams' for t in n.targets))\n    restore_src = '''\nif resume is not None:\n    _restored = restore(resume, strategy)\n    accounts = _restored['accounts']\n    histories = _restored['histories']\n    pending = _restored['pending']\n    seen = _restored['seen']\n    last_bars = _restored['last_bars']\n    journal = _restored['journal']\n    equity = _restored['equity']\n    warnings = _restored['warnings']\n    counts = _restored['counts']\n    position_count = _restored['position_count']\n    warmup_start = resume['next_ms']\n_completed = 0\n'''\n    fn.body[before_streams:before_streams] = ast.parse(restore_src).body\n    loop.body += ast.parse('''\n_completed += 1\nif _completed % checkpoint_every == 0:\n    yield {'kind': 'CHECKPOINT', 'snapshot': capture(locals(), end)}\n    started = time.monotonic()\n''').body\n    # A generator return retains the original result (including its result hash).\n    ast.fix_missing_locations(tree)\n    namespace = dict(vars(simulation), capture=capture, restore=restore)\n    exec(compile(tree, '<pinned-v4-checkpoint-scheduling>', 'exec'), namespace)\n    return namespace[fn.name]\n\nITERATE = make_iterator()\n\ndef chunks(dataset, strategy, config, resume=None, checkpoint_every=120):\n    if type(checkpoint_every) is not int or not 1 <= checkpoint_every <= 1440:\n        raise ValueError('checkpoint interval must be 1\u20131440 timestamps')\n    # Keeping this context inside a generator prevents JS scheduling from\n    # changing Decimal precision between chunks.\n    with localcontext() as context:\n        context.prec = 34\n        it = ITERATE(dataset, strategy, config, None, resume=resume,\n                     checkpoint_every=checkpoint_every)\n        while True:\n            try:\n                yield next(it)\n            except StopIteration as done:\n                yield {'kind': 'DONE', 'result': done.value}\n                return\n"}
